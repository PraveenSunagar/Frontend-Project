<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Typing Speed Test</title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#0f172a;
    font-family:Arial,sans-serif;
}

.container{
    background:white;
    padding:30px;
    border-radius:15px;
    width:450px;
    text-align:center;
    box-shadow:0 10px 20px rgba(0,0,0,.3);
}

#quote{
    font-size:18px;
    margin:15px 0;
    color:#333;
}

textarea{
    width:100%;
    height:100px;
    padding:10px;
    border-radius:10px;
    border:2px solid #ddd;
    resize:none;
}

button{
    margin-top:10px;
    padding:10px 20px;
    border:none;
    border-radius:8px;
    background:#2563eb;
    color:white;
    cursor:pointer;
}

.stats{
    margin-top:15px;
    font-weight:bold;
}
</style>
</head>
<body>

<div class="container">

    <h2>🎯 Typing Speed Test</h2>

    <div id="quote">
        Click start to begin test
    </div>

    <button onclick="startTest()">Start</button>

    <textarea id="input" disabled></textarea>

    <button onclick="finishTest()">Done</button>

    <div class="stats" id="result"></div>

</div>

<script>

const sentences = [
    "JavaScript is fun to learn",
    "Practice makes a programmer perfect",
    "Frontend development is creative",
    "Coding improves problem solving skills",
    "Keep building projects every day"
];

let startTime;

function startTest(){

    const random =
    sentences[Math.floor(Math.random()*sentences.length)];

    document.getElementById("quote").innerText = random;

    document.getElementById("input").value = "";

    document.getElementById("input").disabled = false;

    document.getElementById("input").focus();

    document.getElementById("result").innerText = "";

    startTime = new Date().getTime();
}

function finishTest(){

    const endTime = new Date().getTime();

    const totalTime = (endTime - startTime)/1000;

    const text =
    document.getElementById("input").value;

    const words = text.trim().split(/\s+/).length;

    const speed = Math.round((words/totalTime)*60);

    document.getElementById("result").innerText =
    `⚡ Speed: ${speed} WPM`;

}

</script>

</body>
</html>
