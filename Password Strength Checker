<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Password Strength Checker</title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#0f172a;
    font-family:Arial,sans-serif;
}

.container{
    background:white;
    padding:35px;
    border-radius:15px;
    width:350px;
    text-align:center;
    box-shadow:0 10px 20px rgba(0,0,0,.3);
}

h2{
    margin-bottom:20px;
}

input{
    width:90%;
    padding:12px;
    border:2px solid #ddd;
    border-radius:8px;
    font-size:16px;
}

.bar{
    width:90%;
    height:12px;
    background:#e5e7eb;
    margin:15px auto;
    border-radius:10px;
    overflow:hidden;
}

.fill{
    height:100%;
    width:0%;
    transition:.3s;
}

#message{
    font-size:18px;
    font-weight:bold;
}
</style>
</head>
<body>

<div class="container">

    <h2>🔐 Password Strength Checker</h2>

    <input
        type="password"
        id="password"
        placeholder="Enter Password"
        onkeyup="checkStrength()">

    <div class="bar">
        <div class="fill" id="fill"></div>
    </div>

    <div id="message">
        Enter Password
    </div>

</div>

<script>

function checkStrength(){

    const password =
    document.getElementById("password").value;

    const fill =
    document.getElementById("fill");

    const message =
    document.getElementById("message");

    let strength = 0;

    if(password.length >= 8)
        strength++;

    if(/[A-Z]/.test(password))
        strength++;

    if(/[0-9]/.test(password))
        strength++;

    if(/[^A-Za-z0-9]/.test(password))
        strength++;

    if(strength === 1){

        fill.style.width = "25%";
        fill.style.background = "red";
        message.innerText = "Weak Password";

    }else if(strength === 2){

        fill.style.width = "50%";
        fill.style.background = "orange";
        message.innerText = "Medium Password";

    }else if(strength === 3){

        fill.style.width = "75%";
        fill.style.background = "gold";
        message.innerText = "Good Password";

    }else if(strength === 4){

        fill.style.width = "100%";
        fill.style.background = "green";
        message.innerText = "Strong Password";

    }else{

        fill.style.width = "0%";
        message.innerText = "Enter Password";
    }
}

</script>

</body>
</html>
