<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Color Changer</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    background:#ffffff;
    transition:0.5s;
}

.container{
    text-align:center;
    background:white;
    padding:40px;
    border-radius:10px;
    box-shadow:0 0 15px rgba(0,0,0,0.2);
}

h1{
    margin-bottom:20px;
}

#colorCode{
    font-size:25px;
    margin-bottom:20px;
    font-weight:bold;
}

button{
    padding:15px 30px;
    font-size:18px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    background:#007bff;
    color:white;
}

button:hover{
    background:#0056b3;
}
</style>

</head>
<body>

<div class="container">
    <h1>🎨 Color Changer</h1>

    <p id="colorCode">#FFFFFF</p>

    <button onclick="changeColor()">
        Change Color
    </button>
</div>

<script>

function changeColor(){

    let letters = "0123456789ABCDEF";
    let color = "#";

    for(let i=0;i<6;i++){
        color += letters[Math.floor(Math.random()*16)];
    }

    document.body.style.backgroundColor = color;
    document.getElementById("colorCode").innerHTML = color;

}

</script>

</body>
</html>
