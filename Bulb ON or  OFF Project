<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bulb ON/OFF</title>

<style>
    body{
        margin:0;
        height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;
        background:#111827;
        font-family:Arial,sans-serif;
    }

    .container{
        text-align:center;
    }

    h1{
        color:white;
        margin-bottom:20px;
    }

    .bulb{
        width:150px;
        height:150px;
        border-radius:50%;
        margin:auto;
        background:#444;
        transition:0.4s;
        box-shadow:none;
    }

    .on{
        background:yellow;
        box-shadow:
        0 0 20px yellow,
        0 0 40px yellow,
        0 0 60px yellow;
    }

    button{
        margin-top:30px;
        padding:12px 25px;
        border:none;
        border-radius:10px;
        cursor:pointer;
        font-size:16px;
        background:#3b82f6;
        color:white;
    }

    button:hover{
        opacity:0.8;
    }
</style>
</head>

<body>

<div class="container">

    <h1>💡 Bulb ON/OFF</h1>

    <div class="bulb" id="bulb"></div>

    <button onclick="toggleBulb()">
        ON / OFF
    </button>

</div>

<script>

function toggleBulb(){

    const bulb = document.getElementById("bulb");

    bulb.classList.toggle("on");
}

</script>

</body>
</html>
