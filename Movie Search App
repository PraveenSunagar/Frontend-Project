<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Movie Search UI</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#121212;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
}

.container{
    width:400px;
    background:#1e1e1e;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 15px rgba(255,255,255,.1);
}

h1{
    color:#fff;
    text-align:center;
    margin-bottom:20px;
}

.search-box{
    display:flex;
    gap:10px;
}

input{
    flex:1;
    padding:10px;
    border:none;
    border-radius:5px;
    font-size:16px;
}

button{
    padding:10px 20px;
    border:none;
    border-radius:5px;
    background:#ff9800;
    color:#fff;
    cursor:pointer;
}

button:hover{
    background:#e68900;
}

.card{
    margin-top:20px;
    background:#2b2b2b;
    border-radius:10px;
    overflow:hidden;
    display:none;
}

.card img{
    width:100%;
    height:350px;
    object-fit:cover;
}

.details{
    padding:15px;
    color:white;
}

.details h2{
    margin-bottom:10px;
}

.details p{
    margin:6px 0;
}
</style>

</head>
<body>

<div class="container">

<h1>🎬 Movie Search</h1>

<div class="search-box">
<input type="text" id="movie" placeholder="Enter movie name">
<button onclick="searchMovie()">Search</button>
</div>

<div class="card" id="card">

<img src="https://picsum.photos/400/350" id="poster">

<div class="details">

<h2 id="title">Movie Title</h2>

<p><b>Year:</b> <span id="year">2025</span></p>

<p><b>Rating:</b> ⭐ <span id="rating">8.5</span></p>

<p><b>Genre:</b> <span id="genre">Action</span></p>

<p id="plot">
This is a sample movie description.
</p>

</div>

</div>

</div>

<script>

function searchMovie(){

let name=document.getElementById("movie").value;

if(name===""){
alert("Enter Movie Name");
return;
}

document.getElementById("card").style.display="block";

document.getElementById("title").innerHTML=name;

document.getElementById("year").innerHTML="2025";

document.getElementById("rating").innerHTML="8.9";

document.getElementById("genre").innerHTML="Action / Adventure";

document.getElementById("plot").innerHTML=
"This is a demo movie description. Replace this data using an API later.";

}

</script>

</body>
</html>
