<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Responsive Navbar</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}
nav {
    background: #333;
    padding: 10px 20px;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.logo {
    color: #fff;
    font-size: 22px;
    font-weight: bold;
}

/* Menu */
.menu {
    display: flex;
    list-style: none;
}

.menu li {
    margin-left: 20px;
}

.menu a {
    text-decoration: none;
    color: #fff;
    font-size: 16px;
    transition: 0.3s;
}

.menu a:hover {
    color: #00adb5;
}

.hamburger {
    display: none;
    font-size: 26px;
    color: white;
    cursor: pointer;
}

#menu-toggle {
    display: none;
}

/* Mobile */
@media (max-width: 768px) {
    .menu {
        position: absolute;
        top: 60px;
        left: 0;
        width: 100%;
        background: #333;
        flex-direction: column;
        display: none;
    }

    .menu li {
        margin: 15px 0;
        text-align: center;
    }

    #menu-toggle:checked + .menu {
        display: flex;
    }

    .hamburger {
        display: block;
    }
}
</style>

</head>
<body>

<nav>
    <div class="nav-container">
        <div class="logo">MySite</div>

        <label for="menu-toggle" class="hamburger">&#9776;</label>
        <input type="checkbox" id="menu-toggle">

        <ul class="menu">
            <li><a href="#">Home</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </div>
</nav>

</body>
</html>
