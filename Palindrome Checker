<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Palindrome Checker</title>

<style>
body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#0f172a;
    font-family:Arial,sans-serif;
}

.container{
    background:white;
    padding:35px;
    border-radius:15px;
    width:350px;
    text-align:center;
    box-shadow:0 10px 20px rgba(0,0,0,.3);
}

h2{
    margin-bottom:20px;
}

input{
    width:90%;
    padding:10px;
    border:2px solid #ddd;
    border-radius:8px;
    font-size:16px;
}

button{
    margin-top:15px;
    padding:10px 20px;
    border:none;
    border-radius:8px;
    background:#2563eb;
    color:white;
    cursor:pointer;
}

#result{
    margin-top:20px;
    font-size:20px;
    font-weight:bold;
}
</style>
</head>
<body>

<div class="container">

    <h2>🔄 Palindrome Checker</h2>

    <input
        type="text"
        id="text"
        placeholder="Enter a word">

    <br>

    <button onclick="checkPalindrome()">
        Check
    </button>

    <div id="result"></div>

</div>

<script>

function checkPalindrome(){

    const text =
    document.getElementById("text")
    .value
    .toLowerCase()
    .trim();

    const reversed =
    text.split("")
    .reverse()
    .join("");

    if(text === ""){
        alert("Please enter a word");
        return;
    }

    if(text === reversed){

        document.getElementById("result")
        .innerHTML =
        "✅ It's a Palindrome";

    }else{

        document.getElementById("result")
        .innerHTML =
        "❌ Not a Palindrome";
    }
}

</script>

</body>
</html>
